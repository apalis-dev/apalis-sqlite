  "query": "SELECT\n    id,\n    status,\n    last_result as result,\n    attempts as attempt\nFROM\n    Jobs\nWHERE\n    id IN (\n        SELECT\n            value\n        FROM\n            json_each(?)\n    )\n    AND (\n        status = 'Done'\n        OR (\n            status = 'Failed'\n            AND attempts >= max_attempts\n        )\n        OR status = 'Killed'\n    )\n",
